# Every text file is stored and checked out with LF, also on Windows (core.autocrlf=true would
# otherwise give the containers shell scripts and entrypoints ending in CRLF, which break).
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
*.docx binary
*.bat text eol=crlf
*.ps1 text eol=crlf
