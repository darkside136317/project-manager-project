# =============================================================================
# Project Manager — environment (template for docker/.env)
# =============================================================================
# scripts/bootstrap.ps1 / scripts/bootstrap.sh copy this file to docker/.env and fill
# every empty secret with a random value. Never commit docker/.env.
# Docker Compose reads docker/.env by itself when run from the docker/ folder.

# --- Compose ---
COMPOSE_PROJECT_NAME=pmdev
# Overlays, comma separated: local = run the built image; add docker-compose.dev.yml to edit the source.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.local.yml
# Prefix of the Docker volumes and network (different from document_manager's "docmanager").
DATA_VOLUME_PREFIX=pm

# --- Frappe/ERPNext ---
ERPNEXT_VERSION=v16.26.2
FRAPPE_SITE_NAME=pm.localhost
PUBLIC_URL=http://localhost:8890
HTTP_PUBLISH_PORT=8890

# --- Secrets: leave empty, bootstrap generates them ---
ADMIN_PASSWORD=
MARIADB_ROOT_PASSWORD=
MEILISEARCH_MASTER_KEY=
MINIO_ROOT_PASSWORD=
MINIO_APP_SECRET_KEY=

# --- Company created by the ERPNext setup wizard (change before the first bootstrap) ---
COMPANY_NAME=Công ty Xây dựng Mẫu
COMPANY_ABBR=CTXD
COUNTRY=Vietnam
CURRENCY=VND
TIMEZONE=Asia/Ho_Chi_Minh
LANGUAGE=vi
# Fiscal year start, MM-DD
FY_START=01-01
# Weekly day off in the default holiday list
WEEKLY_OFF=Sunday

# --- Services inside the stack ---
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
# MinIO (photos, documents): administrator, and the application's own user limited to one bucket
MINIO_ROOT_USER=pmadmin
MINIO_APP_ACCESS_KEY=pm-app
MINIO_BUCKET=pm-files

# --- Gunicorn / nginx ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120
