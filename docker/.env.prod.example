# =============================================================================
# Project Manager — production environment (template for docker/.env.prod)
# =============================================================================
# 1. cp docker/.env.prod.example docker/.env.prod && chmod 600 docker/.env.prod
# 2. Fill the site, company and port below. Leave the secrets empty: scripts/deploy_prod.sh generates them.
# 3. scripts/deploy_prod.sh   (it checks this file with scripts/validate_prod_env.py first)
# Never commit docker/.env.prod. Keep a copy of it (and of the backups) somewhere safe: see docs/SAO_LUU_KHOI_PHUC.md.

# --- Compose: unique per deployment (different from the developers' "pmdev"/"pm") ---
COMPOSE_PROJECT_NAME=pmprod
DATA_VOLUME_PREFIX=pmprod
# Optional: keep the data in host folders (absolute path outside the source tree); empty = Docker named volumes
DATA_ROOT=

# --- The image: empty PM_IMAGE builds pm-custom on this server; or the image CI publishes ---
# PM_IMAGE=ghcr.io/<owner>/pm-custom
# PM_IMAGE_TAG=v16.26.2            (the ERPNext version: the newest build of main), latest, or sha-<commit>
PM_IMAGE=
PM_IMAGE_TAG=

# --- Frappe/ERPNext ---
ERPNEXT_VERSION=v16.26.2
# The real DNS name users type; PUBLIC_URL is https:// + this name (TLS ends at the reverse proxy)
FRAPPE_SITE_NAME=
PUBLIC_URL=
# nginx of the stack listens here; only the reverse proxy on this host reaches it
HTTP_PUBLISH_PORT=127.0.0.1:8890
# The reverse proxy reaches nginx through Docker's bridge: trust X-Forwarded-For from there
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12

# --- Secrets: leave empty, scripts/deploy_prod.sh generates them (at least 24 characters, all different) ---
ADMIN_PASSWORD=
MARIADB_ROOT_PASSWORD=
MEILISEARCH_MASTER_KEY=
MINIO_ROOT_PASSWORD=
MINIO_APP_SECRET_KEY=

# --- Company created by the ERPNext setup wizard (before the first deploy) ---
COMPANY_NAME=
COMPANY_ABBR=
COUNTRY=Vietnam
CURRENCY=VND
TIMEZONE=Asia/Ho_Chi_Minh
LANGUAGE=vi
FY_START=01-01
WEEKLY_OFF=Sunday

# --- Services inside the stack ---
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
MINIO_ROOT_USER=pmadmin
MINIO_APP_ACCESS_KEY=pm-app
MINIO_BUCKET=pm-files

# --- Gunicorn / nginx / memory limits (sized for a server with 16 GB) ---
GUNICORN_THREADS=4
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=200m
PROXY_READ_TIMEOUT=120
BACKEND_MEMORY=3G
QUEUE_LONG_MEMORY=2G
DB_MEMORY=3G
